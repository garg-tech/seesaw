# Copy to .env and fill in. Read by the scripts in scripts/ and evaluation/;
# variables already set in the shell take precedence. Never commit .env.

# The server under test (the Seesaw engine or vLLM), as the benchmark client reaches it.
BASE_URL=http://localhost:8000

# SSH host of the GPU machine (a ~/.ssh/config alias works). Leave empty when the
# benchmark client runs on the GPU machine itself. Used by scripts/sync-box.sh and
# evaluation/run-sweeps.sh.
BOX_HOST=

# Path of this repository on the GPU machine, relative to the SSH user's home.
BOX_DIR=seesaw

# Hugging Face token with access to google/gemma-4-12B-it (a gated model). Needed to
# download the weights on the GPU machine and the tokenizer on the client.
HF_TOKEN=
